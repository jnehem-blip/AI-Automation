    {
      "parameters": {
        "jsCode": "// Convert all LLM JSON string outputs into proper JSON objects\n\nconst cleanedItems = [];\n\nfor (const item of items) {\n\n  let jsonString = item.json.text;\n\n  // Remove markdown code blocks if present\n  jsonString = jsonString\n    .replace(/```json/g, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  try {\n\n    const parsedData = JSON.parse(jsonString);\n\n    cleanedItems.push({\n      json: parsedData\n    });\n\n  } catch (error) {\n\n    cleanedItems.push({\n      json: {\n        error: \"Invalid JSON\",\n        originalData: jsonString\n      }\n    });\n\n  }\n\n}\n\nreturn cleanedItems;"
      },
